{
  "version": 2,
  "installCommand": "npm --prefix sweep-pro-frontend install",
  "buildCommand": "npm --prefix sweep-pro-frontend run build",
  "devCommand": "npm --prefix sweep-pro-frontend run dev",
  "outputDirectory": "sweep-pro-frontend/dist",
  "trailingSlash": false,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
